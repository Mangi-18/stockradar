# Copy this file to .env and fill in the first two lines.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=
# Your personal chat id (see README step 1)
TELEGRAM_CHAT_ID=

# Index stocks scanned for prices and momentum (they only ping you via the opportunity score)
INDICES=NIFTY 50,NIFTY MIDCAP 100
# YOUR PORTFOLIO: every relevant item about these reaches you (NSE symbols, comma separated).
# You can also manage it from Telegram: /add SYMBOL, /remove SYMBOL
PORTFOLIO=

# Price alert levels in % (each fires once per day per direction)
MOVE_LEVELS=5,10

# Polling (seconds). Don't go much below 10: NSE may block you.
FILINGS_POLL_FAST=15
FILINGS_POLL_SLOW=30
PRICES_POLL=30
USE_BSE=true

# --- Early signals ---
# Momentum burst: % move within the window, and volume pace vs today's average
MOMENTUM_MOVE=1.5
MOMENTUM_WINDOW_MIN=5
MOMENTUM_VOL_MULT=3
# Pre-open gap alert (~9:06): your stocks / any stock
PREOPEN_MIN_GAP=2
PREOPEN_MIN_GAP_ALL=8
# Minimum values (Rs crore) for promoter trades and bulk/block deals
INSIDER_MIN_CR=0.5
DEAL_MIN_CR=10
# News: seconds between checks, extra RSS feeds (comma separated; empty = built-in list)
NEWS_POLL=30
NEWS_FEEDS=
NEWS_THEMES=true

# --- Noise control ---
# Stocks OUTSIDE your portfolio ping you only when the evidence score (0-100) reaches this
OPP_MIN_SCORE=70
# ...and never more than this many times a day
OPP_MAX_PER_DAY=5
# Weaker candidates (score >= this) go into the digest instead of pinging you
OPP_DIGEST_SCORE=40
# Routine portfolio items: at most one ping per stock per this many minutes (urgent ones always go)
STOCK_COOLDOWN_MIN=60
# Quiet hours (IST, 24h): only urgent portfolio alerts; everything else waits for the 8:30 brief
QUIET_START=23
QUIET_END=7
# When held-back items are sent as one digest message
DIGEST_TIMES=12:30,15:45,20:30
